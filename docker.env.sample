# Sample Environment Variables for Docker Deployment
# ⚠️  IMPORTANT: Copy this to .env and REPLACE ALL VALUES with your actual credentials!
# The application will NOT start with these placeholder values.

# Keycloak OIDC Configuration - REQUIRED
# Issuer is your Keycloak base URL + /realms/<realm-name> (no trailing slash)
KEYCLOAK_ISSUER_URI=https://keycloak.example.com/realms/mp3-transcriber
KEYCLOAK_CLIENT_ID=mp3-transcriber

# AssemblyAI Configuration - REQUIRED
# Get your API key from https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=REPLACE_WITH_YOUR_ASSEMBLYAI_API_KEY

# Optional: Custom JVM Options (leave commented to use defaults)
# JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
